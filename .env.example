# --- Database ---------------------------------------------------------
# IMPORTANT: use your provider's TRANSACTION POOLER connection string,
# not the direct one. Direct connections are commonly IPv6-only while
# serverless functions run over IPv4 -- a direct string passes every
# local test and then fails only in production. Look for:
#   - Supabase: the "Transaction" pooler string, port 6543
#     e.g. postgres://user:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   - Neon: the connection string with "-pooler" in the hostname
#     e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname
#   - Render / RDS Proxy / PgBouncer: whatever your provider labels as
#     "pooled" / "transaction mode" / "pgbouncer"
DATABASE_URL=

# --- App auth -----------------------------------------------------------
# Shared password used to gate the whole app via middleware
APP_PASSWORD=
# Secret used to sign the session cookie set after a correct password
SESSION_SECRET=

# --- AI -------------------------------------------------------------
# Anthropic API key for AI features (post-mortems, pattern analysis, scripts, hooks)
ANTHROPIC_API_KEY=

# --- Instagram Graph API ----------------------------------------------
# Long-lived access token for your Instagram Business/Creator account
INSTAGRAM_ACCESS_TOKEN=
# The ig-user-id the token is for (numeric string, from the Graph API)
INSTAGRAM_USER_ID=

# --- Scheduled sync -----------------------------------------------------
# Set this in your hosting platform's env vars, then add the SAME value
# in the platform's cron/scheduled-function config so /api/sync/cron can
# verify the request actually came from the scheduler and not the public
# internet. On Vercel, set this as an env var and Vercel automatically
# sends it as `Authorization: Bearer $CRON_SECRET` on cron requests.
CRON_SECRET=

# Set to "true" to disable the local-dev-only sync interval (see
# lib/ig/dev-scheduler.ts). Irrelevant in production -- that scheduler
# never runs there regardless.
DISABLE_DEV_SYNC_SCHEDULER=

# --- Misc -----------------------------------------------------------
# IANA timezone used for "when a post happened" and all windowed queries
APP_TIMEZONE=America/Los_Angeles
